SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Neon PostgreSQL (use the JDBC form, not postgresql://)
DATABASE_URL=jdbc:postgresql://ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_USER=neondb_owner
DATABASE_PASSWORD=replace-me
DB_POOL_SIZE=5

# Si ejecutaste db/neon-schema-manual.sql, usa validate.
# Usa update solo si prefieres que Hibernate cree/actualice las tablas.
JPA_DDL_AUTO=update

JWT_SECRET=replace-with-at-least-32-random-characters
QR_SALT=replace-with-random-salt
CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com

R2_ENABLED=true
R2_ACCOUNT_ID=replace-me
# Opcional: si se define, tiene prioridad sobre R2_ACCOUNT_ID
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=saludablemente-assets
R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev
R2_REGION=auto

GEMINI_API_KEY=replace-me

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace-me@gmail.com
MAIL_PASSWORD=replace-me
