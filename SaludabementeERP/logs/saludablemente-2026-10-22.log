        at1_0.fecha_creacion,
        at1_0.fecha_modificacion,
        at1_0.nombre,
        at1_0.usuario_creacion,
        at1_0.usuario_modificacion,
        p1_0.avatar_url,
        p1_0.celular,
        p1_0.documento_identidad,
        p1_0.email,
        e1_0.id_equipo,
        e1_0.activo,
        e1_0.descripcion,
        e1_0.nombre,
        p1_0.estado_civil,
        p1_0.fecha_nacimiento,
        p1_0.nivel_educativo,
        p1_0.nombres,
        p1_0.sexo,
        p1_0.talla_polo 
    from
        slb_personal.persona p1_0 
    left join
        slb_catalogo.cat_area_trabajo at1_0 
            on at1_0.id_area=p1_0.id_area 
    left join
        slb_personal.equipo e1_0 
            on e1_0.id_equipo=p1_0.id_equipo 
    where
        (
            ? is null 
            or p1_0.activo=?
        ) 
        and (
            ? is null 
            or p1_0.sexo=?
        ) 
        and (
            ? is null 
            or p1_0.id_area=?
        ) 
        and (
            ? is null 
            or p1_0.id_equipo=?
        ) 
        and (
            ? is null 
            or lower(p1_0.nombres) like lower(('%'||?||'%')) 
            or lower(p1_0.apellido_paterno) like lower(('%'||?||'%')) 
            or lower(coalesce(p1_0.apellido_materno, '')) like lower(('%'||?||'%')) 
            or lower(p1_0.documento_identidad) like lower(('%'||?||'%'))
        )
