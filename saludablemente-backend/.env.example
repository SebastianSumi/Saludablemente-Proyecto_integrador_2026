# Entorno
NODE_ENV=development
PORT=8080

# Base de datos PostgreSQL Nativo (Servicio postgresql-x64-18)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=saludablemente_db
DB_SSL=false

# Seguridad y JWT (Compatible con Spring Boot backend)
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef0123456789abcdef
JWT_TTL_MINUTOS=60
JWT_ISSUER=saludablemente-backend

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://*.trycloudflare.com

# Cloudflare R2 Storage (S3 API Compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=saludablemente-assets
R2_PUBLIC_URL=https://assets.saludablemente.ejemplo.com

# Gemini IA
GEMINI_API_KEY=
