{
  "name": "saludablemente-mobile",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve --port 4201 --proxy-config proxy.local.json",
    "build": "ng build",
    "build:development": "ng build --configuration development",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:connect": "node scripts/connect-local.mjs",
    "android:debug": "npm run android:sync:local && node scripts/build-android.mjs",
    "test": "node --test tests/*.test.mjs",
    "android:sync:local": "npm run build:development && node scripts/sync-local.mjs"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "22.2.0",
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/share": "8.0.3",
    "@taiga-ui/addon-charts": "5.26.0",
    "@taiga-ui/addon-mobile": "5.26.0",
    "@taiga-ui/addon-table": "5.26.0",
    "@taiga-ui/cdk": "5.26.0",
    "@taiga-ui/core": "5.26.0",
    "@taiga-ui/icons": "5.26.0",
    "@taiga-ui/kit": "5.26.0",
    "@taiga-ui/layout": "5.26.0",
    "echarts": "6.1.0",
    "leaflet": "1.9.4",
    "ngx-echarts": "22.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@capacitor/cli": "8.6.0",
    "@types/leaflet": "1.9.22",
    "jsdom": "28.1.0",
    "less": "4.9.1",
    "node": "^24.22.2",
    "prettier": "3.9.8",
